<Window x:Class="MidiController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MidiController"
        mc:Ignorable="d"
        Title="MidiController" Height="450" Width="800"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="KeysBorder"
                Grid.Row="0"
                Focusable="True"
                Background="#FFF7F7F7"
                BorderBrush="#FFD6D6D6"
                BorderThickness="1"
                CornerRadius="8">
            <Grid Margin="16">
                <TextBlock x:Name="HintTextBlock"
                           FontFamily="Consolas"
                           FontSize="20"
                           Foreground="#FF9C9C9C"
                           Text="Presiona cualquier tecla..." />
                <TextBlock x:Name="KeysTextBlock"
                           FontFamily="Consolas"
                           FontSize="20"
                           Foreground="#FF202020"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="4,8,4,0"
                   FontSize="12"
                   Foreground="#FF707070"
                   Text="Backspace borra el último carácter · Esc limpia todo" />
    </Grid>
</Window>
