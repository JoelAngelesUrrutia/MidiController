<Window x:Class="MidiController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MidiController"
        mc:Ignorable="d"
        Title="MidiController"
        Icon="Assets/app.ico"
        Height="450"
        Width="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DeviceTextBlock"
                   Margin="0,0,0,8"
                   FontSize="14"
                   Foreground="#FF505050"/>

        <Border Grid.Row="1"
                Background="#FFF7F7F7"
                BorderBrush="#FFD6D6D6"
                BorderThickness="1"
                CornerRadius="8">
            <TextBox x:Name="MidiLogTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="16"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12"/>
        </Border>

                <TextBlock Grid.Row="2"
                   Margin="4,8,4,0"
                   FontSize="12"
                   Foreground="#FF707070"
                   Text="Play → Play/Pausa · Stop → Anterior · Record → Siguiente · Knob CC7 → Volumen" />
    </Grid>
</Window>
